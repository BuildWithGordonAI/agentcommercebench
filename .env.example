# ── AWS Bedrock Credentials ────────────────────────────────────────────────
# Key 1 (primary)
AWS_ACCESS_KEY_ID_1=AKIA...
AWS_SECRET_ACCESS_KEY_1=...

# Key 2
AWS_ACCESS_KEY_ID_2=AKIA...
AWS_SECRET_ACCESS_KEY_2=...

# Key 3
AWS_ACCESS_KEY_ID_3=AKIA...
AWS_SECRET_ACCESS_KEY_3=...

# Active key slot (1, 2, or 3)
AWS_KEY_SLOT=1

AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID_1}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY_1}
AWS_DEFAULT_REGION=us-east-1

# ── Bedrock Model IDs ──────────────────────────────────────────────────────
BEDROCK_MODEL_HAIKU=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_SONNET=us.anthropic.claude-sonnet-4-6-20250714-v1:0
BEDROCK_MODEL_OPUS=us.anthropic.claude-opus-4-8-20250514-v1:0

ADVERSARY_MODEL=${BEDROCK_MODEL_HAIKU}

# ── Gordon MCP ─────────────────────────────────────────────────────────────
GORDON_MCP_URL=https://api.withgordon.ai/mcp
GORDON_PUBLIC_KEY=gak_pub_...
GORDON_SECRET_KEY=gak_sec_...
GORDON_AGENT_KEY=${GORDON_SECRET_KEY}
